        </div>

        <div class="hero-right">
            <div class="hero-visual">
                <div class="particles-container">
                    <div class="particle" style="top: 10%; left: 15%; --duration: 4s; --delay: 0s;"></div>
                    <div class="particle purple" style="top: 25%; left: 75%; --duration: 5s; --delay: 1s;"></div>
                    <div class="particle" style="top: 50%; left: 10%; --duration: 3.5s; --delay: 0.5s;"></div>
                    <div class="particle purple" style="top: 70%; left: 85%; --duration: 4.5s; --delay: 2s;"></div>
                    <div class="particle" style="top: 40%; left: 60%; --duration: 6s; --delay: 0.3s;"></div>
                    <div class="particle purple" style="top: 85%; left: 30%; --duration: 3.8s; --delay: 1.5s;"></div>
                    <div class="particle" style="top: 15%; left: 50%; --duration: 5.5s; --delay: 2.5s;"></div>
                    <div class="particle" style="top: 60%; left: 40%; --duration: 4.2s; --delay: 0.8s;"></div>

                    <div class="pixel-fragment" style="top: 20%; left: 10%; --duration: 6s; --delay: 0s;"></div>
                    <div class="pixel-fragment" style="top: 60%; left: 80%; --duration: 7s; --delay: 1s;"></div>
                    <div class="pixel-fragment" style="top: 35%; left: 85%; --duration: 5s; --delay: 2s;"></div>
                    <div class="pixel-fragment" style="top: 75%; left: 15%; --duration: 8s; --delay: 0.5s;"></div>
                </div>

                <div class="ghost-container">
                    <img src="img/ghost.png" alt="Phantom Byte Mascot" class="ghost-img" />
                </div>

                <div class="logo-3d">
                    <img src="img/logo.png" alt="Phantom Byte Logo" class="hero-logo-img" />
