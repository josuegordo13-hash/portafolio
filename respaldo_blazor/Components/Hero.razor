<section class="hero" id="hero">
    <div class="hero-container">
        <div class="hero-left">
            <h1 class="hero-title">
                <span class="line">PHANTOM</span>
                <span class="line">BYTE</span>
            </h1>
            <p class="hero-subtitle">Automatizaci&oacute;n inteligente para negocios y personas.</p>
            <p class="hero-description">
                Creamos software, aplicaciones y sistemas de automatizaci&oacute;n que transforman
                la forma en que trabajas. Tecnolog&iacute;a de punta para resultados reales.
            </p>
            <div class="hero-buttons">
                <a href="#services" class="btn-primary">Ver Servicios</a>
                <a href="#contact" class="btn-secondary">Cont&aacute;ctame</a>
