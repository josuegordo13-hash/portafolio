<section class="contact" id="contact">
    <div class="section-header">
        <span class="section-tag">CONTACTO</span>
        <h2 class="section-title">Hablemos de tu proyecto</h2>
    </div>

    <div class="contact-grid">
        <div class="contact-info">
            <div class="contact-item">
                <div class="contact-icon whatsapp">&#x1F4F1;</div>
                <div class="contact-item-text">
                    <strong>WhatsApp</strong>
                    <span>+1 829 899 2183</span>
                </div>
            </div>

            <div class="contact-item">
                <div class="contact-icon email">&#x2709;</div>
                <div class="contact-item-text">
                    <strong>Correo electr&oacute;nico</strong>
                    <span>josue.gonzalez0979@gmail.com</span>
                </div>
            </div>

            <div class="contact-item">
                <div class="contact-icon location">&#x1F4CD;</div>
                <div class="contact-item-text">
                    <strong>Ubicaci&oacute;n</strong>
                    <span>Disponible Remoto</span>
                </div>
            </div>
        </div>

        <form class="contact-form">
            <div class="form-group">
                <label for="name">Nombre</label>
                <input id="name" type="text" placeholder="Tu nombre" />
            </div>

            <div class="form-group">
                <label for="email">Correo electr&oacute;nico</label>
                <input id="email" type="email" placeholder="tu@correo.com" />
            </div>

            <div class="form-group">
                <label for="subject">Asunto</label>
                <input id="subject" type="text" placeholder="Asunto del mensaje" />
            </div>

            <div class="form-group">
                <label for="message">Descripci&oacute;n del proyecto</label>
                <textarea id="message" placeholder="Cu&eacute;ntame sobre tu proyecto..."></textarea>
            </div>

            <button type="submit" class="submit-btn">Enviar mensaje</button>
        </form>
    </div>
</section>
